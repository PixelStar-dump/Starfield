<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="332dp"
    android:layout_marginStart="20dp"
    android:layout_marginTop="24dp"
    android:layout_marginEnd="20dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="20dp"
        android:id="@+id/wallpaper"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            app:cardCornerRadius="20dp"
            app:strokeColor="?android:attr/textColorPrimary"
            app:rippleColor="?android:colorControlHighlight"
            app:strokeWidth="4dp">

            <com.star.field.Utils.WallpaperView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:elevation="0dp"
                android:orientation="vertical"
                android:scaleType="centerCrop" />

            <TextClock
                android:id="@+id/lockscreen_clock"
                style="@style/op_control_text_style_h6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="false"
                android:layout_gravity="center_horizontal|center_vertical"
                android:fontFamily="@*android:string/config_headlineFontFamily"
                android:format12Hour="hh\nmm"
                android:format24Hour="hh\nmm"
                android:textColor="@*android:color/system_accent1_100"
                android:textFontWeight="300"
                android:textSize="60sp" />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:id="@+id/iconpack"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/stroke_containter">

            <ImageView
                android:id="@+id/icon_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="55dp"
                android:layout_marginLeft="30dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_icon" />

            <TextView
                android:id="@+id/icon_title"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="false"
                android:layout_marginTop="75dp"
                android:layout_marginLeft="10dp"
                android:text="Icons"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp" />

            <TextView
                android:ellipsize="marquee"
                android:text="Set custom icons shape and styes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:layout_marginLeft="10dp"
                android:alpha="0.7"
                android:maxLines="4"
                android:textSize="14.0sp"
                android:textColor="?android:attr/textColorSecondary" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/fonts"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:background="@drawable/stroke_containter">

            <ImageView
                android:id="@+id/font_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="55dp"
                android:layout_marginLeft="30dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_fonts" />

            <TextView
                android:id="@+id/fonts_title2"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="false"
                android:layout_marginTop="80dp"
                android:layout_marginLeft="10dp"
                android:text="Fonts"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp" />

            <TextView
                android:ellipsize="marquee"
                android:text="Set system font style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="105dp"
                android:layout_marginLeft="10dp"
                android:alpha="0.7"
                android:maxLines="4"
                android:textSize="14.0sp"
                android:textColor="?android:attr/textColorSecondary" />

        </RelativeLayout>


    </LinearLayout>

</LinearLayout>